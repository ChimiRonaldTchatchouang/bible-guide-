# Copier ce fichier en .env puis adapter les valeurs.
NODE_ENV=development
PORT=4000

# Base PostgreSQL
DATABASE_URL=postgres://bible:bible@localhost:5432/bible_guide

# Secrets JWT : mettre de longues chaînes aléatoires en production
# (ex. : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=change-moi-access
JWT_REFRESH_SECRET=change-moi-refresh
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=60

# Origines autorisées (séparées par des virgules). * = toutes (pratique pour l'app mobile).
CORS_ORIGINS=*

# Fuseau horaire utilisé pour calculer « le jour du plan » des visiteurs non connectés
APP_TIMEZONE=Africa/Douala
